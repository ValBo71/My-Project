@page
@model CarMaintenance.Web.Pages.Rules.IndexModel
@{
    ViewData["Title"] = "Напомняния и обслужвания";
}

<div class="d-flex justify-content-between align-items-center page-title">
    <h2><i class="fa-solid fa-bell"></i> Напомняния за обслужване на @Model.Car.Make @Model.Car.Model</h2>
    <a asp-page="/Rules/Create" class="btn btn-premium"><i class="fa-solid fa-plus"></i> Добави правило</a>
</div>

<div class="card card-premium mb-4">
    <div class="card-header"><i class="fa-solid fa-gauge-high"></i> Текущо състояние на колата</div>
    <div class="card-body">
        <p class="m-0">Текущ пробег на автомобила: <strong>@Model.Car.CurrentMileage.ToString("N0") км</strong>. Системата автоматично следи оставащите километри и дни по правилата по-долу.</p>
    </div>
</div>

@if (!Model.MaintenanceRules.Any())
{
    <div class="alert alert-info">
        <i class="fa-solid fa-info-circle"></i> Все още няма дефинирани правила за напомняния. Добавете правила (например за смяна на масло, ангренажен ремък, винетка), за да следите тяхното изтичане.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-premium bg-white">
            <thead>
                <tr>
                    <th>Обслужване / Категория</th>
                    <th>Интервали</th>
                    <th>Последно направено</th>
                    <th>Следващо планово</th>
                    <th>Оставащо състояние</th>
                    <th>Статус</th>
                    <th class="text-center">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rule in Model.MaintenanceRules)
                {
                    <tr>
                        <td>
                            <div class="font-weight-bold text-dark">@rule.Name</div>
                            <small class="text-muted">@rule.Category</small>
                        </td>
                        <td>
                            @if (rule.IntervalKm.HasValue)
                            {
                                <div>@rule.IntervalKm.Value.ToString("N0") км</div>
                            }
                            @if (rule.IntervalMonths.HasValue)
                            {
                                <small class="text-muted">@rule.IntervalMonths.Value месеца</small>
                            }
                            @if (!rule.IntervalKm.HasValue && !rule.IntervalMonths.HasValue)
                            {
                                <span class="text-muted">Няма зададен интервал</span>
                            }
                        </td>
                        <td>
                            @if (rule.LastDoneMileage.HasValue || rule.LastDoneDate.HasValue)
                            {
                                @if (rule.LastDoneMileage.HasValue)
                                {
                                    <div>@rule.LastDoneMileage.Value.ToString("N0") км</div>
                                }
                                @if (rule.LastDoneDate.HasValue)
                                {
                                    <small class="text-muted">@rule.LastDoneDate.Value.ToString("dd.MM.yyyy г.")</small>
                                }
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (rule.NextDueMileage.HasValue || rule.NextDueDate.HasValue)
                            {
                                @if (rule.NextDueMileage.HasValue)
                                {
                                    <div class="font-weight-bold text-dark">@rule.NextDueMileage.Value.ToString("N0") км</div>
                                }
                                @if (rule.NextDueDate.HasValue)
                                {
                                    <small class="font-weight-bold text-dark">@rule.NextDueDate.Value.ToString("dd.MM.yyyy г.")</small>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Няма планово</span>
                            }
                        </td>
                        <td>
                            @if (rule.Status == "Gray")
                            {
                                <span class="text-muted">Липсват данни</span>
                            }
                            else
                            {
                                @if (rule.NextDueMileage.HasValue)
                                {
                                    int remainingKm = rule.NextDueMileage.Value - Model.Car.CurrentMileage;
                                    if (remainingKm < 0)
                                    {
                                        <div class="text-danger font-weight-bold">Просрочено с @Math.Abs(remainingKm).ToString("N0") км</div>
                                    }
                                    else
                                    {
                                        <div class="text-success">Остават @remainingKm.ToString("N0") км</div>
                                    }
                                }
                                @if (rule.NextDueDate.HasValue)
                                {
                                    double remainingDays = (rule.NextDueDate.Value.Date - DateTime.Today).TotalDays;
                                    if (remainingDays < 0)
                                    {
                                        <small class="text-danger font-weight-bold d-block">Просрочено с @Math.Abs(remainingDays).ToString("N0") дни</small>
                                    }
                                    else
                                    {
                                        <small class="text-success d-block">Остават @remainingDays.ToString("N0") дни</small>
                                    }
                                }
                            }
                        </td>
                        <td>
                            @switch (rule.Status)
                            {
                                case "Red":
                                    <span class="status-badge red">Просрочено</span>
                                    break;
                                case "Yellow":
                                    <span class="status-badge yellow">Наближава</span>
                                    break;
                                case "Green":
                                    <span class="status-badge green">Наред</span>
                                    break;
                                default:
                                    <span class="status-badge gray">Няма данни</span>
                                    break;
                            }
                        </td>
                        <td class="text-center">
                            <form method="post" asp-page-handler="Delete" asp-route-id="@rule.Id" onsubmit="return confirm('Сигурни ли сте, че искате да изтриете това напомняне?');">
                                <button type="submit" class="btn btn-danger btn-sm rounded-0">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
