@page
@model CarMaintenance.Web.Pages.Cars.CreateModel
@{
    ViewData["Title"] = "Добави автомобил";
}

<div class="page-title">
    <h2><i class="fa-solid fa-plus"></i> Добавяне на нов автомобил</h2>
</div>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card card-premium">
            <div class="card-header">
                <i class="fa-solid fa-car-side"></i> Информация за автомобила
            </div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Car.Make" class="form-label">Марка *</label>
                            <input asp-for="Car.Make" class="form-control" placeholder="напр. Citroën" required />
                            <span asp-validation-for="Car.Make" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Car.Model" class="form-label">Модел *</label>
                            <input asp-for="Car.Model" class="form-control" placeholder="напр. C8" required />
                            <span asp-validation-for="Car.Model" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Car.Engine" class="form-label">Двигател *</label>
                            <input asp-for="Car.Engine" class="form-control" placeholder="напр. 2.2 HDi 128hp" required />
                            <span asp-validation-for="Car.Engine" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Car.Year" class="form-label">Година на производство *</label>
                            <input asp-for="Car.Year" class="form-control" type="number" min="1900" max="2100" required />
                            <span asp-validation-for="Car.Year" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Car.RegistrationNumber" class="form-label">Регистрационен Номер *</label>
                            <input asp-for="Car.RegistrationNumber" class="form-control" placeholder="напр. CB1234AB" required />
                            <span asp-validation-for="Car.RegistrationNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Car.Vin" class="form-label">VIN (Рама)</label>
                            <input asp-for="Car.Vin" class="form-control" placeholder="17-символен код" />
                            <span asp-validation-for="Car.Vin" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Car.Fuel" class="form-label">Тип Гориво *</label>
                            <select asp-for="Car.Fuel" class="form-select" asp-items="Html.GetEnumSelectList<CarMaintenance.Core.Enums.FuelType>()"></select>
                            <span asp-validation-for="Car.Fuel" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Car.CurrentMileage" class="form-label">Текущ Пробег (км) *</label>
                            <input asp-for="Car.CurrentMileage" class="form-control" type="number" min="0" required />
                            <span asp-validation-for="Car.CurrentMileage" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UploadedImage" class="form-label">Снимка на автомобила</label>
                        <input asp-for="UploadedImage" type="file" class="form-control" accept="image/*" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Car.Notes" class="form-label">Бележки / Описание</label>
                        <textarea asp-for="Car.Notes" class="form-control" rows="3" placeholder="Допълнителни детайли за колата..."></textarea>
                        <span asp-validation-for="Car.Notes" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-page="./Index" class="btn btn-premium-outline">Отказ</a>
                        <button type="submit" class="btn btn-premium">Добави автомобил</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
